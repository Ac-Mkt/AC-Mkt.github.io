---
// Layout for every blog post: byline, table of contents, author box and schema
import type { ImageMetadata, MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	heroImageAlt?: string;
	heroImageCredit?: string;
	heroImageCreditUrl?: string;
	headings?: MarkdownHeading[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt = '',
	heroImageCredit,
	heroImageCreditUrl,
	headings = [],
} = Astro.props;

const toc = headings.filter((h) => h.depth === 2);
const format = (date: Date) =>
	date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const siteUrl = (Astro.site ?? new URL('https://ac-mkt.github.io')).href.replace(/\/$/, '');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageUrl = `${siteUrl}${path}`;
const imageUrl = heroImage ? new URL(heroImage.src, siteUrl).href : `${siteUrl}/og-default.png`;
const person = { '@type': 'Person', '@id': `${siteUrl}/#person`, name: 'Ana Carolina Gomes' };

// BlogPosting + breadcrumb schema, linked to the Person in BaseHead
const postSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BlogPosting',
			'@id': `${pageUrl}#article`,
			headline: title,
			description,
			image: imageUrl,
			datePublished: pubDate.toISOString(),
			dateModified: (updatedDate ?? pubDate).toISOString(),
			mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
			author: { ...person, url: `${siteUrl}/about/` },
			publisher: person,
			inLanguage: 'en',
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
				{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
				{ '@type': 'ListItem', position: 3, name: title, item: pageUrl },
			],
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${title} | Ana Carolina Gomes`}
			description={description}
			image={heroImage?.src}
			imageAlt={heroImageAlt || undefined}
			type="article"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/blog/">All posts</a>

			<header class="post-head">
				<h1>{title}</h1>
				<p class="byline">
					By <a href="/about/" rel="author">Ana Carolina Gomes</a>
					<span aria-hidden="true">·</span>
					<time datetime={pubDate.toISOString()}>{format(pubDate)}</time>
					{
						updatedDate && (
							<>
								<span aria-hidden="true">·</span>
								Updated <time datetime={updatedDate.toISOString()}>{format(updatedDate)}</time>
							</>
						)
					}
				</p>
			</header>

			{
				heroImage && (
					<figure class="hero">
						<Image src={heroImage} width={1600} alt={heroImageAlt} loading="eager" fetchpriority="high" />
						{heroImageCredit && (
							<figcaption>
								Photo:{' '}
								{heroImageCreditUrl ? <a href={heroImageCreditUrl}>{heroImageCredit}</a> : heroImageCredit}
							</figcaption>
						)}
					</figure>
				)
			}

			<div class:list={['post-body', { 'has-toc': toc.length > 2 }]}>
				{
					toc.length > 2 && (
						<details class="toc" open>
							<summary>On this page</summary>
							<ol>
								{toc.map((h) => (
									<li>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
						</details>
					)
				}
				<!-- Phones: start the table of contents collapsed so the article is visible first.
				     Inline so it runs before the first paint (no jump). -->
				<script is:inline>
					if (window.matchMedia('(max-width: 600px)').matches) {
						document.querySelector('.toc')?.removeAttribute('open');
					}
				</script>

				<article class="prose">
					<slot />

					<aside class="author">
						<p class="author-name">Written by Ana Carolina Gomes</p>
						<p>
							SEO specialist working on content, on-page and off-page SEO, Digital PR and brand
							visibility in AI search since 2023.
						</p>
						<p class="author-links">
							<a href="/about/">More about me</a>
							<a href="/case-studies/">Case studies</a>
							<a href="https://www.linkedin.com/in/anacpsg" rel="me">LinkedIn</a>
						</p>
					</aside>
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-head {
		max-width: 52rem;
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	h1 {
		margin-bottom: 1.25rem;
		font-size: clamp(2.25rem, 5.5vw, 4rem);
		letter-spacing: -0.035em;
		line-height: 1.02;
	}

	.byline {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.byline span {
		margin: 0 0.4rem;
	}

	.hero {
		margin: 0 0 clamp(2.5rem, 6vw, 4rem);
	}

	.hero :global(img) {
		width: 100%;
		aspect-ratio: 40 / 21;
		object-fit: cover;
		border-radius: 4px;
	}

	.hero figcaption {
		margin-top: 0.6rem;
		color: var(--muted);
		font-size: 0.8rem;
	}

	.hero figcaption a {
		color: inherit;
	}

	/* Content + table of contents */
	.post-body.has-toc {
		display: grid;
		grid-template-columns: minmax(0, var(--prose)) minmax(0, 16rem);
		justify-content: space-between;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.toc {
		order: 2;
		position: sticky;
		top: 2rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--rule);
		font-size: 0.85rem;
	}

	.toc summary {
		margin-bottom: 0.75rem;
		color: var(--ink);
		font-weight: 500;
		cursor: pointer;
	}

	.toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc li + li {
		margin-top: 0.55rem;
	}

	.toc a {
		color: var(--muted);
		line-height: 1.35;
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--link);
		text-decoration: underline;
	}

	/* Article typography */
	.prose > :global(p:first-child) {
		color: var(--ink);
		font-size: clamp(1.15rem, 1.8vw, 1.3rem);
		line-height: 1.55;
	}

	.prose :global(a) {
		text-decoration-thickness: 1px;
	}

	/* Author box */
	.author {
		margin-top: clamp(3.5rem, 8vw, 5rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.95rem;
	}

	.author p {
		margin-bottom: 0.6rem;
	}

	.author-name {
		color: var(--ink);
		font-weight: 500;
	}

	.author-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}

	@media (max-width: 960px) {
		.post-body.has-toc {
			grid-template-columns: minmax(0, 1fr);
		}

		.toc {
			order: 0;
			position: static;
			margin-bottom: 2.5rem;
		}
	}

	/* Phones: bigger tap areas in the table of contents */
	@media (max-width: 600px) {
		.toc {
			margin-bottom: 1.5rem;
			padding-top: 0;
		}

		.toc summary {
			margin-bottom: 0;
			padding: 0.75rem 0;
		}

		.toc li + li {
			margin-top: 0;
		}

		.toc a {
			display: block;
			padding: 0.55rem 0;
		}
	}
</style>
