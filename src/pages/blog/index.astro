---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const format = (date: Date) =>
	date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const title = 'Blog | Ana Carolina Gomes';
const description =
	'Practical guides to SEO, brand visibility and AI search by Ana Carolina Gomes, with real examples from her work in competitive markets.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>Blog</h1>
				<p>
					What I've learned building SEO and brand authority in some of the toughest markets online,
					explained for anyone who wants to learn SEO.
				</p>
			</header>

			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a class:list={['post-item', { 'no-thumb': !post.data.heroImage }]} href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image
										class="post-thumb"
										src={post.data.heroImage}
										alt=""
										widths={[320, 480, 640]}
										sizes="(max-width: 600px) 100vw, 240px"
									/>
								)}
								<time datetime={post.data.pubDate.toISOString()}>{format(post.data.pubDate)}</time>
								<span class="post-main">
									<span class="post-title">{post.data.title}</span>
									<span class="post-desc">{post.data.description}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.posts {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.posts li {
		border-top: 1px solid var(--rule);
	}

	.posts li:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.post-item {
		display: grid;
		grid-template-areas:
			'thumb date'
			'thumb main';
		grid-template-columns: 15rem minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		gap: 0.25rem 2.5rem;
		align-items: start;
		padding: 1.6rem 0;
		color: inherit;
		text-decoration: none;
	}

	.post-item.no-thumb {
		grid-template-areas:
			'date'
			'main';
		grid-template-columns: minmax(0, 1fr);
	}

	time {
		grid-area: date;
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.9;
	}

	.post-main {
		grid-area: main;
	}

	.post-title {
		display: block;
		margin-bottom: 0.4rem;
		color: var(--ink);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.post-item:hover .post-title {
		color: var(--link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.post-desc {
		display: block;
		max-width: 40rem;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.post-item :global(.post-thumb) {
		grid-area: thumb;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		border-radius: 4px;
		background: var(--surface);
	}

	@media (max-width: 860px) {
		.post-item {
			grid-template-columns: 11rem minmax(0, 1fr);
			column-gap: 1.5rem;
		}
	}

	@media (max-width: 600px) {
		.post-item {
			grid-template-areas:
				'thumb'
				'date'
				'main';
			grid-template-columns: 1fr;
			grid-template-rows: auto;
		}

		.post-item :global(.post-thumb) {
			margin-bottom: 0.75rem;
		}
	}
</style>
