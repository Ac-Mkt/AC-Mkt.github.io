---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const format = (date: Date) =>
	date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const title = 'Blog | Ana Carolina Gomes';
const description =
	'Notes on SEO, GEO, link building and AI-assisted workflows by Ana Carolina Gomes, written from hands-on work.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>Blog</h1>
				<p>Notes on SEO, GEO, link building and AI workflows, written from hands-on work.</p>
			</header>

			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a class="post-item" href={`/blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>{format(post.data.pubDate)}</time>
								<span class="post-main">
									<span class="post-title">{post.data.title}</span>
									<span class="post-desc">{post.data.description}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.posts {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.posts li {
		border-top: 1px solid var(--rule);
	}

	.posts li:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.post-item {
		display: grid;
		grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
		gap: 0.5rem 2.5rem;
		padding: 1.6rem 0;
		color: inherit;
		text-decoration: none;
	}

	time {
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.9;
	}

	.post-title {
		display: block;
		margin-bottom: 0.4rem;
		color: var(--ink);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.post-item:hover .post-title {
		color: var(--link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.post-desc {
		display: block;
		max-width: 40rem;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	@media (max-width: 600px) {
		.post-item {
			grid-template-columns: 1fr;
		}
	}
</style>
