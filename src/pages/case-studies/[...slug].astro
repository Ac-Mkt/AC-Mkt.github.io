---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Only published case studies get their own page
export async function getStaticPaths() {
	const cases = await getCollection('caseStudies', ({ data }) => data.status === 'published');
	return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, result, type, tools, pubDate } = entry.data;

const published = pubDate.toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

// Article + breadcrumb schema. Author and publisher link to the Person in BaseHead.
const siteUrl = (Astro.site ?? new URL('https://ac-mkt.github.io')).href.replace(/\/$/, '');
const pageUrl = `${siteUrl}/case-studies/${entry.id}/`;
const person = { '@type': 'Person', '@id': `${siteUrl}/#person`, name: 'Ana Carolina Gomes' };

const caseSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Article',
			'@id': `${pageUrl}#article`,
			headline: title,
			description,
			image: `${siteUrl}/og-default.png`,
			datePublished: pubDate.toISOString(),
			dateModified: pubDate.toISOString(),
			mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
			author: person,
			publisher: person,
			inLanguage: 'en',
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
				{ '@type': 'ListItem', position: 2, name: 'Case studies', item: `${siteUrl}/case-studies/` },
				{ '@type': 'ListItem', position: 3, name: title, item: pageUrl },
			],
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Ana Carolina Gomes`} description={description} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(caseSchema)} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/case-studies/">All case studies</a>

			<header class="case-head">
				<p class="case-type">{type}</p>
				<h1>{title}</h1>
				<p class="case-desc">{description}</p>

				<dl class="case-meta">
					<div>
						<dt>Result</dt>
						<dd>{result}</dd>
					</div>
					<div>
						<dt>Tools</dt>
						<dd>{tools.join(', ')}</dd>
					</div>
					<div>
						<dt>Published</dt>
						<dd><time datetime={pubDate.toISOString()}>{published}</time></dd>
					</div>
				</dl>
			</header>

			<article class="prose">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.back {
		display: inline-block;
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
		color: var(--muted);
		font-size: 0.9rem;
	}

	.back:hover {
		color: var(--link);
	}

	.case-head {
		max-width: 52rem;
		margin-bottom: clamp(3rem, 7vw, 4.5rem);
	}

	.case-type {
		margin-bottom: 0.75rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	h1 {
		margin-bottom: 1.25rem;
		font-size: clamp(2.25rem, 5.5vw, 4rem);
		letter-spacing: -0.035em;
		line-height: 1;
	}

	.case-desc {
		max-width: 40rem;
		margin-bottom: 2.25rem;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.55;
	}

	.case-meta {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
	}

	.case-meta dt {
		margin-bottom: 0.25rem;
		color: var(--muted);
		font-size: 0.8rem;
	}

	.case-meta dd {
		margin: 0;
		color: var(--ink);
		font-size: 0.95rem;
		line-height: 1.45;
	}

	/* Markdown content */
	.prose {
		max-width: var(--prose);
	}

	.prose :global(h2) {
		margin-top: 2.75em;
		font-size: 1.75rem;
	}

	.prose :global(h3) {
		margin-top: 2em;
		font-size: 1.2rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.25em;
		padding-left: 1.25em;
	}

	.prose :global(li + li) {
		margin-top: 0.4em;
	}

	.prose :global(table) {
		display: block;
		margin: 1.5em 0 2em;
		overflow-x: auto;
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 700px) {
		.case-meta {
			grid-template-columns: 1fr;
		}
	}
</style>
