---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseList from '../components/CaseList.astro';
import { getCollection } from 'astro:content';
import { CERTIFICATIONS as certifications } from '../consts';

const title = 'Ana Carolina Gomes | SEO & Digital PR Specialist';
const description =
	'SEO specialist focused on link acquisition, Digital PR and AI-assisted SEO workflows for competitive, regulated markets.';

// Hero numbers. Only real, verifiable results.
const stats = [
	{ value: '250+', label: 'high-authority backlinks secured per quarter' },
	{ value: '25%', label: 'lower average cost per link' },
	{ value: '20+', label: 'media and affiliate partners managed' },
];

// Featured case studies: the first three by "order" in src/content/case-studies
const featured = (await getCollection('caseStudies'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const tools = [
	'Ahrefs',
	'Semrush',
	'Google Search Console',
	'Google Analytics',
	'Claude Code',
	'Python',
	'Excel',
];

// Add real recommendations here (e.g. from LinkedIn). The section stays hidden while empty.
// Example: { quote: '...', name: 'Full Name', role: 'Head of SEO, Company' },
const testimonials: { quote: string; name: string; role: string }[] = [];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Hero -->
			<section class="hero">
				<div class="hero-text">
					<ul class="stats">
						{
							stats.map((stat) => (
								<li>
									<span class="stat-value">{stat.value}</span>
									<span class="stat-label">{stat.label}</span>
								</li>
							))
						}
					</ul>

					<h1>Ana Carolina Gomes</h1>

					<p class="intro">
						SEO and Digital PR specialist. I help brands earn authority in search through link
						acquisition, media partnerships and outreach in highly competitive, regulated markets,
						and I build AI-assisted workflows that make SEO operations faster and compliance-safe.
					</p>

					<div class="actions">
						<a class="btn btn-primary" href="/case-studies/">See case studies</a>
						<a class="btn" href="/Ana-Carolina-Gomes-CV.pdf" download>Download CV</a>
					</div>
				</div>

				<!-- Photo placeholder: replace with your photo later -->
				<figure class="portrait" aria-hidden="true">
					<span>AC</span>
				</figure>
			</section>

			<!-- Selected work -->
			<section class="section" aria-labelledby="work-title">
				<h2 id="work-title">Selected work</h2>
				<div>
					<CaseList cases={featured} />
					<a class="text-link" href="/case-studies/">All case studies</a>
				</div>
			</section>

			<!-- Tools and certifications -->
			<section class="section" aria-labelledby="tools-title">
				<h2 id="tools-title">Tools and certifications</h2>
				<div class="tools-grid">
					<ul class="tools">
						{tools.map((tool) => <li>{tool}</li>)}
					</ul>
					<ul class="certs">
						{
							certifications.map((cert) => (
								<li>
									<span class="cert-name">{cert.name}</span>
									<span class="cert-meta">
										{cert.issuer}, {cert.year}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- Testimonials (hidden until the list above has entries) -->
			{
				testimonials.length > 0 && (
					<section class="section" aria-labelledby="quotes-title">
						<h2 id="quotes-title">What colleagues say</h2>
						<div class="quotes">
							{testimonials.map((t) => (
								<figure class="quote">
									<blockquote>{t.quote}</blockquote>
									<figcaption>
										<span class="quote-name">{t.name}</span>
										<span class="quote-role">{t.role}</span>
									</figcaption>
								</figure>
							))}
						</div>
					</section>
				)
			}

			<!-- Contact -->
			<section class="contact" aria-labelledby="contact-title">
				<h2 id="contact-title">Looking for an SEO or Digital PR specialist?</h2>
				<p>I'm open to new roles and projects. The fastest way to reach me is by email or LinkedIn.</p>
				<div class="actions">
					<a class="btn btn-primary" href="mailto:contato.carolpss@gmail.com">Email me</a>
					<a class="btn" href="https://www.linkedin.com/in/anacpsg" rel="me">LinkedIn</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding: clamp(2rem, 6vw, 5rem) var(--gutter) 2rem;
	}

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: end;
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(1.5rem, 4vw, 3rem);
		margin: 0 0 clamp(2.5rem, 6vw, 4.5rem);
		padding: 0;
		list-style: none;
	}

	.stat-value {
		display: block;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.stat-label {
		display: block;
		max-width: 15ch;
		margin-top: 0.5rem;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.4;
	}

	h1 {
		margin: 0 0 1.75rem;
		font-size: clamp(3rem, 8.5vw, 6.75rem);
		letter-spacing: -0.045em;
		line-height: 0.92;
	}

	.intro {
		max-width: 34rem;
		margin: 0 0 2.25rem;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.55;
	}

	.portrait {
		display: grid;
		place-items: center;
		margin: 0;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--surface);
		border-radius: 4px;
	}

	.portrait span {
		color: #c9c9c5;
		font-size: clamp(4rem, 10vw, 8rem);
		font-weight: 500;
		letter-spacing: -0.05em;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
	}

	/* ---------- Links ---------- */
	.text-link {
		display: inline-block;
		margin-top: 1.75rem;
		font-size: 0.95rem;
		text-underline-offset: 0.25em;
	}

	/* ---------- Sections ---------- */
	.section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		margin-top: clamp(5rem, 11vw, 8.5rem);
		padding-top: 1.75rem;
		border-top: 1px solid var(--rule);
	}

	.section h2,
	.contact h2 {
		margin: 0;
		font-size: clamp(1.6rem, 2.6vw, 2.1rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	/* Tools and certifications */
	.tools-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 2.5rem;
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		align-content: start;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tools li {
		padding: 0.5rem 1rem;
		border: 1px solid #c9c9c5;
		border-radius: 999px;
		font-size: 0.9rem;
		line-height: 1.2;
	}

	.certs {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.certs li + li {
		margin-top: 1.1rem;
	}

	.cert-name {
		display: block;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.cert-meta {
		display: block;
		color: var(--muted);
		font-size: 0.85rem;
	}

	/* Testimonials */
	.quotes {
		display: grid;
		gap: 2.5rem;
	}

	.quote {
		margin: 0;
	}

	.quote blockquote {
		margin: 0 0 1rem;
		padding: 0;
		border: 0;
		font-size: 1.15rem;
		line-height: 1.55;
	}

	.quote-name {
		display: block;
		font-weight: 500;
	}

	.quote-role {
		display: block;
		color: var(--muted);
		font-size: 0.85rem;
	}

	/* Contact */
	.contact {
		margin-top: clamp(5rem, 11vw, 8.5rem);
		padding: clamp(2.5rem, 6vw, 4.5rem) 0;
		border-top: 1px solid var(--rule);
	}

	.contact h2 {
		max-width: 18ch;
		margin-bottom: 1rem;
		font-size: clamp(2rem, 4.5vw, 3.25rem);
	}

	.contact p {
		max-width: 34rem;
		margin: 0 0 2rem;
		font-size: 1.05rem;
		line-height: 1.55;
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 860px) {
		.hero,
		.section,
		.tools-grid {
			grid-template-columns: 1fr;
		}

		.portrait {
			max-width: 420px;
			aspect-ratio: 1 / 1;
		}
	}
</style>
