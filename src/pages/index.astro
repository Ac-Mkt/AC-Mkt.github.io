---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/ana-carolina-gomes-color.jpg';
import { formatDate, isoDate } from '../utils/date';
import { readingTime } from '../utils/readingTime';

const title = 'Ana Carolina Gomes — SEO and brand visibility';
const description =
	'How brands get found, trusted and cited in search: projects and notes from practice by Ana Carolina Gomes, SEO specialist in Belo Horizonte, Brazil.';

const EMAIL = 'contato.carolpss@gmail.com';
const LINKEDIN = 'https://www.linkedin.com/in/anacpsg';

const work = [
	{
		href: '/case-studies/',
		label: 'Professional work · 2023 to now',
		title: 'SEO in international, high-competition markets',
		description:
			'Link building and Digital PR at the core: an outreach and media partnership program across international markets, balancing link quality with acquisition cost. Around it, content and on-page work, plus AI-assisted workflows built with Claude Code and Python.',
		areas: 'Link building · Digital PR · Content · On-page · AI workflows',
		metric: '250+',
		metricLabel: 'links per quarter, 25% lower cost per link',
	},
	{
		href: '/case-studies/greensip-mini-capstone/',
		label: 'Course project',
		title: 'GreenSip: an answer-ready article on a YMYL topic',
		description:
			'Keyword strategy, AI-assisted writing and schema markup for "green tea for weight loss", built for a fictional wellness brand to practice content that search engines and AI tools can trust.',
		metric: '66.5k',
		metricLabel: 'monthly US searches in a 6-keyword cluster; schema with zero errors',
	},
];

// Latest post (the collection has no draft field, so every post is published)
const [latest] = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Hero -->
			<section class="container hero" aria-labelledby="hero-title">
				<div class="hero-text">
					<p class="eyebrow">Ana Carolina Gomes · SEO &amp; GEO Specialist · Belo Horizonte, Brazil</p>
					<h1 id="hero-title">How brands get found, trusted and cited in search.</h1>
					<p class="intro">
						In almost four years of SEO, I’ve worked across content, on-page and off-page, mostly in
						international, high-competition markets. Links, mentions and clear content shape which
						brands AI tools choose to cite.
					</p>
					<div class="actions hero-actions">
						<a class="btn btn-primary" href="/case-studies/">See my work</a>
						<a class="btn" href="/blog/">Read the blog</a>
					</div>
				</div>

				<figure class="portrait">
					<Image
						src={portrait}
						alt="Ana Carolina Gomes, SEO specialist"
						width={456}
						height={528}
						widths={[416, 456, 768, 912, 1200]}
						sizes="(max-width: 1023px) calc(100vw - 48px), (min-width: 1600px) 456px, (min-width: 1280px) 416px, 360px"
						loading="eager"
						fetchpriority="high"
					/>
					<span class="badge"><span class="dot" aria-hidden="true"></span>Open to new roles</span>
				</figure>
			</section>

			<!-- Selected work -->
			<section class="container block" aria-labelledby="work-title">
				<div class="block-inner">
					<div class="block-head">
						<h2 id="work-title">Selected work</h2>
						<p>
							What I do day to day, and a project from my studies: the problem, what I did and what
							came out of it.
						</p>
					</div>
					<div class="block-body">
						<ul class="work">
							{
								work.map((item) => (
									<li>
										<a class="work-item" href={item.href}>
											<div class="work-text">
												<span class="label">{item.label}</span>
												<h3 class="item-title">{item.title}</h3>
												<span class="desc">{item.description}</span>
												{item.areas && <span class="areas">{item.areas}</span>}
											</div>
											<div class="work-metric">
												<span class="metric">{item.metric}</span>
												<span class="metric-label">{item.metricLabel}</span>
											</div>
										</a>
									</li>
								))
							}
						</ul>
						<a class="text-link" href="/case-studies/">All work</a>
					</div>
				</div>
			</section>

			<!-- Latest notes -->
			<section class="container block" aria-labelledby="notes-title">
				<div class="block-inner">
					<div class="block-head">
						<h2 id="notes-title">Latest notes</h2>
						<p>Practical writing on SEO, GEO, link building and AI workflows.</p>
					</div>
					<div class="block-body">
						{
							latest && (
								<a class="note" href={`/blog/${latest.id}/`}>
									{latest.data.heroImage && (
										<Image
											class="note-img"
											src={latest.data.heroImage}
											alt=""
											widths={[176, 208, 320, 416]}
											sizes="(max-width: 767px) 88px, (max-width: 1023px) 160px, 208px"
											loading="lazy"
										/>
									)}
									<div class="note-text">
										<span class="note-meta">
											{latest.data.category && <span class="note-category">{latest.data.category} · </span>}
											<time datetime={isoDate(latest.data.pubDate)}>{formatDate(latest.data.pubDate)}</time>
										</span>
										<h3 class="item-title">{latest.data.title}</h3>
										<span class="desc note-desc">{latest.data.description}</span>
										<span class="note-read">{readingTime(latest.body)} min read</span>
									</div>
								</a>
							)
						}
						<a class="text-link all-posts" href="/blog/">All posts</a>
					</div>
				</div>
			</section>

			<!-- Get in touch -->
			<section class="container contact-wrap" aria-labelledby="contact-title">
				<div class="contact">
					<div>
						<h2 id="contact-title">Get in touch</h2>
						<p>
							A project in SEO or brand visibility, a role, or just want to compare notes? Email or
							LinkedIn is the best way to reach me.
						</p>
					</div>
					<div class="contact-actions">
						<div class="email-field">
							<span class="email">{EMAIL}</span>
							<button class="copy" type="button" data-copy={EMAIL}>Copy</button>
						</div>
						<span class="sr-only" aria-live="polite" data-copy-status></span>
						<div class="contact-buttons">
							<a class="btn btn-primary" href={`mailto:${EMAIL}`}>Email me</a>
							<a class="btn" href={LINKEDIN} target="_blank" rel="noopener me">LinkedIn</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Copy the email address; the label shows "Copied" for 2 seconds and screen readers hear it
			const button = document.querySelector<HTMLButtonElement>('[data-copy]');
			const status = document.querySelector<HTMLElement>('[data-copy-status]');
			let timer: number | undefined;

			button?.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(button.dataset.copy ?? '');
					button.textContent = 'Copied';
					if (status) status.textContent = 'Email address copied';
					window.clearTimeout(timer);
					timer = window.setTimeout(() => {
						button.textContent = 'Copy';
						if (status) status.textContent = '';
					}, 2000);
				} catch {
					if (status) status.textContent = 'Could not copy. Select the address to copy it.';
				}
			});
		</script>
	</body>
</html>

<style>
	/* ---------- Page ---------- */
	.home {
		max-width: none;
		margin: 0;
		padding: 0;
	}

	h2 {
		margin: 0;
	}

	.desc {
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	.item-title {
		margin: 0;
		color: var(--ink);
		font-size: 24px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
		text-underline-offset: 4px;
	}

	.text-link {
		display: inline-block;
		margin-top: 32px;
		color: var(--ink);
		font-size: 15px;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 416px;
		gap: 96px;
		align-items: center;
		padding-top: 96px;
	}

	.hero-text {
		min-width: 0;
	}

	.eyebrow {
		margin: 0 0 16px;
		color: var(--meta);
		font-size: 15px;
		line-height: 1.5;
	}

	h1 {
		margin: 0;
		color: var(--ink);
		font-size: 64px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.intro {
		max-width: 520px;
		margin: 24px 0 0;
		color: var(--ink-2);
		font-size: 18px;
		line-height: 1.5;
	}

	.hero-actions {
		margin-top: 32px;
	}

	.portrait {
		position: relative;
		height: 480px;
		margin: 0;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 24px;
		object-fit: cover;
		object-position: 45% 30%;
	}

	.badge {
		position: absolute;
		top: 16px;
		left: 16px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 32px;
		padding: 0 16px;
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--success);
	}

	/* ---------- Sections (Selected work, Latest notes) ---------- */
	.block {
		margin-top: 128px;
	}

	.block-inner {
		display: grid;
		grid-template-columns: 288px minmax(0, 1fr);
		gap: 64px;
		padding-top: 48px;
		border-top: 1px solid var(--line);
	}

	.block-head h2 {
		color: var(--ink);
		font-size: 32px;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.block-head p {
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	.block-body {
		min-width: 0;
	}

	/* Work items */
	.work {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 208px;
		gap: 48px;
		color: inherit;
		text-decoration: none;
	}

	.work li:first-child .work-item {
		padding-bottom: 32px;
		border-bottom: 1px solid var(--line);
	}

	.work li + li .work-item {
		padding-top: 32px;
	}

	.work-text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.label {
		color: var(--meta);
		font-size: 13px;
		line-height: 1.5;
	}

	.areas {
		color: var(--meta);
		font-size: 14px;
		line-height: 1.5;
	}

	.work-metric {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-left: 24px;
		border-left: 1px solid var(--line);
	}

	.metric {
		color: var(--ink);
		font-size: 48px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.metric-label {
		color: var(--meta);
		font-size: 14px;
		line-height: 1.5;
	}

	.work-item:hover .item-title,
	.note:hover .item-title {
		text-decoration: underline;
	}

	/* Latest notes */
	.note {
		display: flex;
		align-items: flex-start;
		gap: 32px;
		color: inherit;
		text-decoration: none;
	}

	.note :global(.note-img) {
		flex: none;
		width: 208px;
		height: 136px;
		border-radius: 8px;
		object-fit: cover;
	}

	.note-text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.note-meta {
		color: var(--meta);
		font-size: 13px;
		line-height: 1.5;
	}

	/* Category and read time only appear in the compact mobile row */
	.note-category,
	.note-read {
		display: none;
	}

	/* ---------- Get in touch ---------- */
	.contact-wrap {
		margin-top: 128px;
	}

	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 416px;
		gap: 64px;
		align-items: end;
		padding: 64px;
		border-radius: 24px;
		background: var(--surface);
	}

	.contact h2 {
		color: var(--ink);
		font-size: 48px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.contact p {
		max-width: 496px;
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 18px;
		line-height: 1.5;
	}

	.contact-actions {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 0;
	}

	.email-field {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 56px;
		padding: 0 4px 0 24px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg);
	}

	.email {
		min-width: 0;
		overflow: hidden;
		color: var(--ink);
		font-size: 16px;
		text-overflow: ellipsis;
		white-space: nowrap;
		user-select: all;
	}

	.copy {
		flex: none;
		height: 48px;
		padding: 0 24px;
		border: 0;
		border-radius: 999px;
		background: var(--ink);
		color: #fafaf8;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
	}

	.contact-buttons {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---------- Large and widescreen (≥1600px) ---------- */
	@media (min-width: 1600px) {
		h1 {
			font-size: 72px;
		}

		.hero {
			grid-template-columns: minmax(0, 1fr) 456px;
			gap: 128px;
		}

		.portrait {
			height: 528px;
		}

		.block-inner {
			grid-template-columns: 320px minmax(0, 1fr);
		}
	}

	/* ---------- Small desktop / laptop (1024–1279px) ---------- */
	@media (max-width: 1279px) {
		h1 {
			font-size: 56px;
		}

		.hero {
			grid-template-columns: minmax(0, 1fr) 360px;
			gap: 64px;
		}

		.portrait {
			height: 440px;
		}

		.block-inner {
			grid-template-columns: 240px minmax(0, 1fr);
			gap: 48px;
		}

		.work-item {
			grid-template-columns: minmax(0, 1fr) 176px;
			gap: 32px;
		}

		.contact {
			grid-template-columns: minmax(0, 1fr) 360px;
			gap: 48px;
			padding: 48px;
		}
	}

	/* ---------- Tablet (768–1023px) ---------- */
	@media (max-width: 1023px) {
		h1 {
			font-size: 48px;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.portrait {
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 3;
			max-height: 480px;
		}

		.block,
		.contact-wrap {
			margin-top: 96px;
		}

		.block-inner {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.block-head h2 {
			font-size: 28px;
		}

		.work-item {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.work-metric {
			margin-top: 16px;
			padding-left: 0;
			border-left: 0;
		}

		.metric {
			font-size: 40px;
		}

		.note {
			gap: 24px;
		}

		.note :global(.note-img) {
			width: 160px;
			height: 104px;
		}

		.contact {
			grid-template-columns: 1fr;
			gap: 32px;
			padding: 48px;
		}

		.contact h2 {
			font-size: 40px;
		}
	}

	/* ---------- Mobile (<768px) ---------- */
	@media (max-width: 767px) {
		h1 {
			font-size: 40px;
		}

		.intro {
			font-size: 16px;
		}

		.hero-actions .btn {
			flex: 1 1 auto;
		}

		.portrait {
			aspect-ratio: 4 / 5;
			max-height: none;
		}

		.portrait :global(img) {
			border-radius: 20px;
		}

		.block-inner {
			padding-top: 32px;
		}

		.item-title {
			font-size: 20px;
		}

		/* Latest notes: compact row card */
		.note {
			align-items: center;
			gap: 14px;
			padding: 12px;
			border-radius: 16px;
			background: var(--surface);
		}

		.note :global(.note-img) {
			width: 88px;
			height: 88px;
			border-radius: 12px;
		}

		.note-text {
			gap: 4px;
		}

		.note-meta {
			font-size: 12px;
		}

		.note-category,
		.note-read {
			display: inline;
		}

		.note-read {
			color: var(--meta);
			font-size: 13px;
		}

		.note .item-title {
			font-size: 17px;
			line-height: 1.25;
		}

		.note-desc {
			display: none;
		}

		/* "All posts" becomes a full-width secondary button */
		.all-posts {
			display: flex;
			align-items: center;
			justify-content: center;
			height: 48px;
			margin-top: 20px;
			border: 1px solid var(--ink);
			border-radius: 999px;
			text-decoration: none;
		}

		/* Bigger tap area for "All work" */
		.text-link:not(.all-posts) {
			margin-top: 20px;
			padding: 12px 0;
		}

		.contact {
			padding: 24px;
			border-radius: 20px;
		}

		.contact h2 {
			font-size: 36px;
		}

		.contact-buttons {
			grid-template-columns: 1fr;
		}
	}
</style>
