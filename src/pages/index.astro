---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseList from '../components/CaseList.astro';
import Hero from '../components/Hero.astro';
import LatestNotes from '../components/LatestNotes.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/ana-carolina-gomes-color.jpg';
import { CERTIFICATIONS as certifications } from '../consts';

const title = 'Ana Carolina Gomes — SEO and brand visibility';
const description =
	'How brands get found, trusted and cited in search: projects and notes from practice by Ana Carolina Gomes, SEO specialist in Belo Horizonte, Brazil.';

// Featured case studies: the first three by "order" in src/content/case-studies
const featured = (await getCollection('caseStudies'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const tools = [
	'Ahrefs',
	'Semrush',
	'Google Search Console',
	'Google Analytics',
	'Claude Code',
	'Python',
	'Excel',
];

// Add real recommendations here (e.g. from LinkedIn). The section stays hidden while empty.
// Example: { quote: '...', name: 'Full Name', role: 'Head of SEO, Company' },
const testimonials: { quote: string; name: string; role: string }[] = [];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="home">
			<Hero
				eyebrow={['Ana Carolina Gomes', 'SEO and brand visibility', 'Belo Horizonte, Brazil']}
				title="How brands get found, trusted and cited in search."
				subtitle="In almost four years of SEO, I’ve worked across content, on-page and off-page, mostly in international, high-competition markets. Links, mentions and clear content shape not only rankings but which brands AI tools choose to cite. This site is where I write about that work and what I learn from it."
				actions={[
					{ label: 'Read the notes', href: '/blog/', primary: true },
					{ label: 'See my work', href: '/case-studies/' },
				]}
			>
				<figure class="portrait" slot="media">
					<Image
						src={portrait}
						alt="Ana Carolina Gomes"
						widths={[420, 640, 900, 1080]}
						sizes="(max-width: 860px) min(420px, 100vw), 450px"
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
				<Image
					slot="avatar"
					src={portrait}
					alt=""
					width={72}
					height={72}
					densities={[1, 2, 3]}
					loading="eager"
				/>
			</Hero>

			<!-- Selected work -->
			<section class="section" aria-labelledby="work-title">
				<div>
					<h2 id="work-title">Selected work</h2>
					<p class="section-intro">
						Projects from my day-to-day work and my studies: the problem, what I did and what came
						out of it.
					</p>
				</div>
				<div>
					<CaseList cases={featured} />
					<a class="text-link" href="/case-studies/">All case studies</a>
				</div>
			</section>

			<!-- Latest notes -->
			<section class="section notes-section" aria-labelledby="notes-title">
				<div>
					<h2 id="notes-title">Latest notes</h2>
					<p class="section-intro notes-intro">
						Practical writing on SEO, GEO, link building and AI workflows.
					</p>
				</div>
				<div>
					<LatestNotes />
				</div>
			</section>

			<!-- What I work with -->
			<section class="section" aria-labelledby="tools-title">
				<div>
					<h2 id="tools-title">What I work with</h2>
					<p class="section-intro">The tools I use day to day, and the courses that shaped how I work.</p>
				</div>
				<div class="tools-grid">
					<ul class="tools">
						{tools.map((tool) => <li>{tool}</li>)}
					</ul>
					<ul class="certs">
						{
							certifications.map((cert) => (
								<li>
									<span class="cert-name">{cert.name}</span>
									<span class="cert-meta">
										{cert.issuer}, {cert.year}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- Testimonials (hidden until the list above has entries) -->
			{
				testimonials.length > 0 && (
					<section class="section" aria-labelledby="quotes-title">
						<h2 id="quotes-title">What colleagues say</h2>
						<div class="quotes">
							{testimonials.map((t) => (
								<figure class="quote">
									<blockquote>{t.quote}</blockquote>
									<figcaption>
										<span class="quote-name">{t.name}</span>
										<span class="quote-role">{t.role}</span>
									</figcaption>
								</figure>
							))}
						</div>
					</section>
				)
			}

			<!-- Contact -->
			<section class="contact" aria-labelledby="contact-title">
				<h2 id="contact-title">Get in touch</h2>
				<p>
					Questions about something I wrote, a project in SEO or brand visibility, or just want to
					compare notes? Email or LinkedIn is the best way to reach me.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="mailto:contato.carolpss@gmail.com">Email me</a>
					<a class="btn" href="https://www.linkedin.com/in/anacpsg" rel="me">LinkedIn</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding: clamp(2rem, 6vw, 5rem) var(--gutter) 2rem;
	}

	/* ---------- Hero portrait (layout lives in Hero.astro) ---------- */
	.portrait {
		display: grid;
		place-items: center;
		margin: 0;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--surface);
		border-radius: 4px;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ---------- Links ---------- */
	/* The padding gives a ~44px tap area; the margin offsets it so the layout doesn't move */
	.text-link {
		display: inline-block;
		margin-top: 1.05rem;
		padding: 0.7rem 0;
		font-size: 0.95rem;
		text-underline-offset: 0.25em;
	}

	/* ---------- Sections ---------- */
	.section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		margin-top: clamp(5rem, 11vw, 8.5rem);
		padding-top: 1.75rem;
		border-top: 1px solid var(--rule);
	}

	.section h2,
	.contact h2 {
		margin: 0;
		font-size: clamp(1.6rem, 2.6vw, 2.1rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	.section-intro {
		max-width: 20rem;
		margin: 0.9rem 0 0;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	/* What I work with */
	.tools-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 2.5rem;
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		align-content: start;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tools li {
		padding: 0.5rem 1rem;
		border: 1px solid #c9c9c5;
		border-radius: 999px;
		font-size: 0.9rem;
		line-height: 1.2;
	}

	.certs {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.certs li + li {
		margin-top: 1.1rem;
	}

	.cert-name {
		display: block;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.cert-meta {
		display: block;
		color: var(--muted);
		font-size: 0.85rem;
	}

	/* Testimonials */
	.quotes {
		display: grid;
		gap: 2.5rem;
	}

	.quote {
		margin: 0;
	}

	.quote blockquote {
		margin: 0 0 1rem;
		padding: 0;
		border: 0;
		font-size: 1.15rem;
		line-height: 1.55;
	}

	.quote-name {
		display: block;
		font-weight: 500;
	}

	.quote-role {
		display: block;
		color: var(--muted);
		font-size: 0.85rem;
	}

	/* Contact */
	.contact {
		margin-top: clamp(5rem, 11vw, 8.5rem);
		padding: clamp(2.5rem, 6vw, 4.5rem) 0;
		border-top: 1px solid var(--rule);
	}

	.contact h2 {
		max-width: 18ch;
		margin-bottom: 1rem;
		font-size: clamp(2rem, 4.5vw, 3.25rem);
	}

	.contact p {
		max-width: 34rem;
		margin: 0 0 2rem;
		font-size: 1.05rem;
		line-height: 1.55;
	}

	/* ---------- Responsive ---------- */
	@media (max-width: 860px) {
		.section,
		.tools-grid {
			grid-template-columns: 1fr;
		}

		.portrait {
			max-width: 420px;
			aspect-ratio: 1 / 1;
		}
	}

	/* Phones: tighter vertical rhythm between sections */
	@media (max-width: 600px) {
		.section,
		.contact {
			margin-top: 3.25rem;
		}

		.section {
			gap: 1.25rem;
		}

		.text-link {
			margin-top: 0.5rem;
		}

		/* Latest notes header on phones */
		.notes-section {
			gap: 0;
		}

		.notes-section h2 {
			font-size: 30px;
			font-weight: 500;
			letter-spacing: -0.02em;
		}

		.notes-intro {
			margin: 8px 0 24px;
			color: #3e3d3a;
			font-size: 16px;
			line-height: 1.5;
		}
	}
</style>
