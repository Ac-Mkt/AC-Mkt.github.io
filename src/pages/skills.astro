---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CERTIFICATIONS, CERTIFICATIONS_INTRO, LEARNING, SKILL_AREAS } from '../data/skills';

const title = 'Skills — Ana Carolina Gomes';
const description =
	'SEO, GEO, link building, Digital PR and AI automation skills of Ana Carolina Gomes, with the tools she uses and the certifications she holds.';

// Breadcrumb (the Person schema with knowsAbout and hasCredential is in BaseHead)
const siteUrl = (Astro.site ?? new URL('https://ac-mkt.github.io')).href.replace(/\/$/, '');
const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
		{ '@type': 'ListItem', position: 2, name: 'Skills', item: `${siteUrl}/skills/` },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
	</head>
	<body>
		<Header />
		<main class="skills">
			<header class="intro">
				<h1>Skills</h1>
				<p>
					What I work with, grouped by area. For how these skills play out in practice, see the{' '}
					<a href="/case-studies/">case studies</a>.
				</p>
			</header>

			<div class="rows">
				{
					SKILL_AREAS.map((area) => (
						<section class="row">
							<div class="head">
								<h2>{area.title}</h2>
								<p>{area.description}</p>
							</div>
							<ul class="tags">
								{area.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</section>
					))
				}

				<section class="row">
					<div class="head">
						<h2>{LEARNING.title}</h2>
						<p>{LEARNING.description}</p>
					</div>
					<ul class="tags learning">
						{
							LEARNING.items.map((item) => (
								<li>
									<span class="dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</section>

				<section class="row">
					<div class="head">
						<h2>{CERTIFICATIONS_INTRO.title}</h2>
						<p>{CERTIFICATIONS_INTRO.description}</p>
					</div>
					<div class="certs">
						{
							CERTIFICATIONS.map((cert) =>
								cert.url ? (
									<a class="cert" href={cert.url} target="_blank" rel="noopener">
										<span class="cert-name">{cert.name}</span>
										<span class="cert-meta">
											{cert.issuer}, {cert.year}
										</span>
										<span class="cert-link">
											View certificate <span aria-hidden="true">↗</span>
											<span class="sr-only">(opens in a new tab)</span>
										</span>
									</a>
								) : (
									<div class="cert">
										<span class="cert-name">{cert.name}</span>
										<span class="cert-meta">
											{cert.issuer}, {cert.year}
										</span>
									</div>
								),
							)
						}
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ---------- Page ---------- */
	.skills {
		padding-top: 96px;
		padding-bottom: 64px; /* + the footer's 64px top margin = 128px below the last row */
	}

	.intro h1 {
		margin: 0;
		color: var(--ink);
		font-size: 64px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.intro p {
		max-width: 640px;
		margin: 24px 0 0;
		color: var(--ink-2);
		font-size: 18px;
		line-height: 1.5;
	}

	.intro a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* ---------- Rows ---------- */
	.rows {
		margin-top: 64px;
		border-top: 1px solid var(--line);
	}

	.row {
		display: grid;
		grid-template-columns: 288px minmax(0, 1fr);
		column-gap: 64px;
		padding: 40px 0;
		border-bottom: 1px solid var(--line);
	}

	.row:last-child {
		border-bottom: 0;
	}

	.head {
		min-width: 0;
	}

	.head h2 {
		margin: 0;
		color: var(--ink);
		font-size: 24px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	.head p {
		margin: 8px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	/* Tags: plain labels, not links */
	.tags {
		display: flex;
		flex-wrap: wrap;
		align-content: flex-start;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 8px 14px;
		border-radius: 8px;
		background: var(--tag);
		color: var(--ink);
		font-size: 15px;
		line-height: 1.4;
		cursor: default;
	}

	.learning li {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 14px;
		border: 1px dashed var(--dashed);
		background: transparent;
	}

	.dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--progress);
	}

	/* Certifications */
	.certs {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.cert {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 120px 140px;
		gap: 24px;
		align-items: baseline;
		padding: 16px 0;
		border-bottom: 1px solid var(--line-soft);
		color: inherit;
		text-decoration: none;
	}

	.cert-name {
		color: var(--ink);
		font-size: 17px;
		font-weight: 500;
		text-underline-offset: 4px;
	}

	a.cert:hover .cert-name {
		text-decoration: underline;
	}

	.cert-meta {
		color: var(--meta);
		font-size: 14px;
	}

	.cert-link {
		color: var(--ink);
		font-size: 14px;
		font-weight: 600;
		text-align: right;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---------- ≥1600px ---------- */
	@media (min-width: 1600px) {
		.intro h1 {
			font-size: 72px;
		}

		.row {
			grid-template-columns: 320px minmax(0, 1fr);
		}
	}

	/* ---------- 1024–1279px ---------- */
	@media (max-width: 1279px) {
		.row {
			grid-template-columns: 240px minmax(0, 1fr);
			column-gap: 48px;
		}

		.cert {
			grid-template-columns: minmax(0, 1fr) 110px 130px;
		}
	}

	/* ---------- 768–1023px ---------- */
	@media (max-width: 1023px) {
		.intro h1 {
			font-size: 48px;
		}

		.row {
			grid-template-columns: 1fr;
			row-gap: 24px;
		}
	}

	/* ---------- <768px ---------- */
	@media (max-width: 767px) {
		.intro h1 {
			font-size: 40px;
		}

		.intro p {
			font-size: 16px;
		}

		.row {
			padding: 32px 0;
		}

		.tags li {
			font-size: 14px;
		}

		.cert {
			grid-template-columns: 1fr;
			gap: 4px;
		}

		.cert-link {
			text-align: left;
		}
	}
</style>
