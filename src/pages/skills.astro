---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Collapsible from '../components/Collapsible.astro';
import { CERTIFICATIONS, CERTIFICATIONS_INTRO, LEARNING, SKILL_AREAS } from '../data/skills';

// Closed-section summary on phones: the first 3 skills, then "+N" for the rest
const areaSummary = (items: string[]) =>
	items.slice(0, 3).join(', ') + (items.length > 3 ? ` +${items.length - 3}` : '');

const title = 'Skills — Ana Carolina Gomes';
const description =
	'SEO, GEO, link building, Digital PR and AI automation skills of Ana Carolina Gomes, with the tools she uses and the certifications she holds.';

// Breadcrumb (the Person schema with knowsAbout and hasCredential is in BaseHead)
const siteUrl = (Astro.site ?? new URL('https://ac-mkt.github.io')).href.replace(/\/$/, '');
const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
		{ '@type': 'ListItem', position: 2, name: 'Skills', item: `${siteUrl}/skills/` },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
	</head>
	<body>
		<Header />
		<main class="skills">
			<header class="intro">
				<h1>Skills</h1>
				<p class="d-only">
					What I work with, grouped by area. For how these skills play out in practice, see the{' '}
					<a href="/case-studies/">case studies</a>.
				</p>
				<p class="m-only">
					What I work with, grouped by area. See them in practice in the{' '}
					<a href="/case-studies/">case studies</a>.
				</p>
			</header>

			<!-- Phones: the same data as collapsible sections -->
			<div class="m-sections m-only">
				{
					SKILL_AREAS.map((area, i) => (
						<Collapsible title={area.title} summary={areaSummary(area.items)} open={i === 0} truncate>
							<p class="m-desc">{area.description}</p>
							<ul class="m-tags">
								{area.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</Collapsible>
					))
				}

				<Collapsible title={LEARNING.title} summary={LEARNING.items.join(', ')} truncate>
					<p class="m-desc">{LEARNING.description}</p>
					<ul class="m-tags m-learning">
						{
							LEARNING.items.map((item) => (
								<li>
									<span class="dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</Collapsible>

				<Collapsible
					title={CERTIFICATIONS_INTRO.title}
					summary={CERTIFICATIONS.map((c) => `${c.issuer} ${c.year}`).join(' · ')}
					truncate
				>
					<p class="m-desc m-desc-certs">{CERTIFICATIONS_INTRO.description}</p>
					<div class="m-certs">
						{
							CERTIFICATIONS.map((cert) =>
								cert.url ? (
									<a class="m-cert" href={cert.url} target="_blank" rel="noopener">
										<span class="m-cert-name">{cert.name}</span>
										<span class="m-cert-meta">
											{cert.issuer}, {cert.year}
										</span>
										<span class="m-cert-link">
											View certificate <span aria-hidden="true">↗</span>
											<span class="sr-only">(opens in a new tab)</span>
										</span>
									</a>
								) : (
									<div class="m-cert">
										<span class="m-cert-name">{cert.name}</span>
										<span class="m-cert-meta">
											{cert.issuer}, {cert.year}
										</span>
									</div>
								),
							)
						}
					</div>
				</Collapsible>
			</div>

			<!-- Tablet and desktop -->
			<div class="rows d-only">
				{
					SKILL_AREAS.map((area) => (
						<section class="row">
							<div class="head">
								<h2>{area.title}</h2>
								<p>{area.description}</p>
							</div>
							<ul class="tags">
								{area.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</section>
					))
				}

				<section class="row">
					<div class="head">
						<h2>{LEARNING.title}</h2>
						<p>{LEARNING.description}</p>
					</div>
					<ul class="tags learning">
						{
							LEARNING.items.map((item) => (
								<li>
									<span class="dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</section>

				<section class="row">
					<div class="head">
						<h2>{CERTIFICATIONS_INTRO.title}</h2>
						<p>{CERTIFICATIONS_INTRO.description}</p>
					</div>
					<div class="certs">
						{
							CERTIFICATIONS.map((cert) =>
								cert.url ? (
									<a class="cert" href={cert.url} target="_blank" rel="noopener">
										<span class="cert-name">{cert.name}</span>
										<span class="cert-meta">
											{cert.issuer}, {cert.year}
										</span>
										<span class="cert-link">
											View certificate <span aria-hidden="true">↗</span>
											<span class="sr-only">(opens in a new tab)</span>
										</span>
									</a>
								) : (
									<div class="cert">
										<span class="cert-name">{cert.name}</span>
										<span class="cert-meta">
											{cert.issuer}, {cert.year}
										</span>
									</div>
								),
							)
						}
					</div>
				</section>
			</div>
		</main>
		<Footer compact />
	</body>
</html>

<style>
	/* ---------- Page ---------- */
	.skills {
		padding-top: 96px;
		padding-bottom: 64px; /* + the footer's 64px top margin = 128px below the last row */
	}

	.intro h1 {
		margin: 0;
		color: var(--ink);
		font-size: 64px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.intro p {
		max-width: 640px;
		margin: 24px 0 0;
		color: var(--ink-2);
		font-size: 18px;
		line-height: 1.5;
	}

	.intro a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* ---------- Rows ---------- */
	.rows {
		margin-top: 64px;
		border-top: 1px solid var(--line);
	}

	.row {
		display: grid;
		grid-template-columns: 288px minmax(0, 1fr);
		column-gap: 64px;
		padding: 40px 0;
		border-bottom: 1px solid var(--line);
	}

	.row:last-child {
		border-bottom: 0;
	}

	.head {
		min-width: 0;
	}

	.head h2 {
		margin: 0;
		color: var(--ink);
		font-size: 24px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	.head p {
		margin: 8px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	/* Tags: plain labels, not links */
	.tags {
		display: flex;
		flex-wrap: wrap;
		align-content: flex-start;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 8px 14px;
		border-radius: 8px;
		background: var(--tag);
		color: var(--ink);
		font-size: 15px;
		line-height: 1.4;
		cursor: default;
	}

	.learning li {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 14px;
		border: 1px dashed var(--dashed);
		background: transparent;
	}

	.dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--progress);
	}

	/* Certifications */
	.certs {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.cert {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 120px 140px;
		gap: 24px;
		align-items: baseline;
		padding: 16px 0;
		border-bottom: 1px solid var(--line-soft);
		color: inherit;
		text-decoration: none;
	}

	.cert-name {
		color: var(--ink);
		font-size: 17px;
		font-weight: 500;
		text-underline-offset: 4px;
	}

	a.cert:hover .cert-name {
		text-decoration: underline;
	}

	.cert-meta {
		color: var(--meta);
		font-size: 14px;
	}

	.cert-link {
		color: var(--ink);
		font-size: 14px;
		font-weight: 600;
		text-align: right;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---------- ≥1600px ---------- */
	@media (min-width: 1600px) {
		.intro h1 {
			font-size: 72px;
		}

		.row {
			grid-template-columns: 320px minmax(0, 1fr);
		}
	}

	/* ---------- 1024–1279px ---------- */
	@media (max-width: 1279px) {
		.row {
			grid-template-columns: 240px minmax(0, 1fr);
			column-gap: 48px;
		}

		.cert {
			grid-template-columns: minmax(0, 1fr) 110px 130px;
		}
	}

	/* ---------- 768–1023px ---------- */
	@media (max-width: 1023px) {
		.intro h1 {
			font-size: 48px;
		}

		.row {
			grid-template-columns: 1fr;
			row-gap: 24px;
		}
	}

	/* ---------- <768px ---------- */
	/* Phone and wider-screen variants (below / from 768px) */
	@media (min-width: 768px) {
		.m-only {
			display: none !important;
		}
	}

	@media (max-width: 767px) {
		.d-only {
			display: none !important;
		}

		.skills {
			padding-top: 24px;
			padding-bottom: 0;
		}

		.intro h1 {
			font-size: 32px;
			letter-spacing: -0.03em;
			line-height: 1.1;
		}

		.intro p {
			margin-top: 12px;
			font-size: 15px;
			line-height: 1.5;
		}

		/* Collapsible sections (component: Collapsible.astro) */
		.m-sections {
			margin-top: 32px;
			border-top: 1px solid var(--line);
		}

		.m-desc {
			margin: 0 0 12px;
			color: var(--muted);
			font-size: 14px;
			line-height: 1.5;
		}

		.m-desc-certs {
			margin-bottom: 4px;
		}

		.m-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 6px;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.m-tags li {
			padding: 6px 10px;
			border-radius: 8px;
			background: var(--tag);
			color: var(--ink);
			font-size: 14px;
			line-height: 1.4;
			cursor: default;
		}

		.m-learning li {
			display: flex;
			align-items: center;
			gap: 6px;
			padding: 5px 10px;
			border: 1px dashed var(--dashed);
			background: transparent;
		}

		.m-learning .dot {
			width: 7px;
			height: 7px;
		}

		.m-certs {
			display: flex;
			flex-direction: column;
		}

		.m-cert {
			display: flex;
			flex-direction: column;
			gap: 2px;
			padding: 12px 0;
			border-bottom: 1px solid var(--line-soft);
			color: inherit;
			text-decoration: none;
		}

		.m-cert:last-child {
			border-bottom: 0;
		}

		.m-cert-name {
			color: var(--ink);
			font-size: 16px;
			font-weight: 500;
		}

		.m-cert-meta {
			color: var(--meta);
			font-size: 13px;
		}

		.m-cert-link {
			color: var(--ink);
			font-size: 14px;
			font-weight: 600;
		}
	}
</style>
