---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absolute, ids, personNode } from '../utils/schema';

const title = 'About | Ana Carolina Gomes';
const description =
	'Ana Carolina Gomes is an SEO specialist in Belo Horizonte, Brazil, working across content, on-page and off-page SEO and brand visibility in AI search.';

const experience = [
	{ role: 'SEO Off-Page Specialist', company: 'Odds Scanner Group', dates: 'Jul 2024 – Present' },
	{ role: 'Junior Off-Page Specialist', company: 'Odds Scanner Group', dates: 'Sep 2023 – Jul 2024' },
	{ role: 'SEO Intern', company: 'GShield', dates: 'Feb 2023 – Sep 2023' },
	{ role: 'Marketing Intern', company: 'BrunSker Tecnologia', dates: 'Sep 2022 – Nov 2022' },
];

const languages = ['Portuguese (native)', 'English (C1)', 'Spanish (A1)'];

// ProfilePage + the full Person entity: this page is where the author lives.
// Posts and the rest of the site point to it by @id.
const pageUrl = absolute(Astro.site, '/about/');
const schema = [
	{
		'@type': 'ProfilePage',
		'@id': pageUrl,
		url: pageUrl,
		mainEntity: { '@id': ids(Astro.site).person },
		isPartOf: { '@id': ids(Astro.site).website },
	},
	await personNode(Astro.site),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} schema={schema} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>About</h1>
			</header>

			<div class="layout">
				<div class="story">
					<p>
						I started in marketing and found SEO through content. My first SEO role involved writing
						optimized product content and running on-page audits for a high-traffic e-commerce site,
						which taught me how much small technical fixes and clear writing can affect visibility.
					</p>
					<p>
						Since 2023, I’ve focused on off-page SEO: building media partnerships, running outreach and
						earning high-authority links across international markets. Today, I secure 250–300 links
						per quarter, manage relationships with more than 20 media and affiliate partners, and have
						reduced our average cost per link by 25% through better outreach and negotiation.
					</p>
					<p>
						Some of my favorite work sits between SEO and operations. I built an AI-assisted workflow
						with Claude Code and Python that turns a spreadsheet into ready-to-use content briefs,
						sending AI tools only the data they actually need.
					</p>
					<p>
						Right now, I’m deepening my skills in technical SEO, data analysis (SQL, BigQuery and Looker
						Studio) and Generative Engine Optimization. I’m most interested in work that connects the
						full picture, from content and technical SEO to authority and AI search.
					</p>

					<div class="actions">
						<a class="btn btn-primary" href="/Ana-Carolina-Gomes-CV.pdf" download>Download CV</a>
						<a class="btn" href="https://www.linkedin.com/in/anacpsg" rel="me">LinkedIn</a>
					</div>
				</div>

				<aside class="facts">
					<section>
						<h2>Experience</h2>
						<ul class="timeline">
							{
								experience.map((job) => (
									<li>
										<span class="job-role">{job.role}</span>
										<span class="job-meta">
											{job.company}, {job.dates}
										</span>
									</li>
								))
							}
						</ul>
					</section>

					<section>
						<h2>Education</h2>
						<p class="fact">
							<span class="job-role">Higher Education Degree (CST) in Marketing</span>
							<span class="job-meta">Universidade Estácio de Sá, 2022 – 2024</span>
						</p>
					</section>

					<section>
						<h2>Languages</h2>
						<p class="fact">{languages.join(', ')}</p>
					</section>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		max-width: 48rem;
	}

	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.story {
		max-width: var(--prose);
	}

	.story p {
		margin-bottom: 1.3em;
	}

	.facts section + section {
		margin-top: 2.5rem;
	}

	.facts h2 {
		margin-bottom: 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--rule);
		font-size: 1rem;
		letter-spacing: 0;
	}

	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.timeline li + li {
		margin-top: 1rem;
	}

	.job-role {
		display: block;
		color: var(--ink);
		font-weight: 500;
		line-height: 1.35;
	}

	.job-meta {
		display: block;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.fact {
		margin: 0;
	}

	.actions {
		margin-top: 2.25rem;
	}

	@media (max-width: 860px) {
		.layout {
			grid-template-columns: 1fr;
		}
	}
</style>
