---
// Case study list, used on the Home page and on /case-studies
import type { CollectionEntry } from 'astro:content';

interface Props {
	cases: CollectionEntry<'caseStudies'>[];
}

const { cases } = Astro.props;
---

<ul class="work">
	{
		cases.map((entry) => {
			const live = entry.data.status === 'published';
			const Tag = live ? 'a' : 'div';
			return (
				<li>
					<Tag
						class:list={['work-item', { 'is-pending': !live }]}
						href={live ? `/case-studies/${entry.id}/` : undefined}
					>
						<span class="work-main">
							<span class="work-type">{entry.data.type}</span>
							<span class="work-title">{entry.data.title}</span>
							<span class="work-summary">{entry.data.description}</span>
						</span>
						<span class="work-side">
							<span class="work-result">{entry.data.result}</span>
							{!live && <span class="work-status">Full case study coming soon</span>}
						</span>
					</Tag>
				</li>
			);
		})
	}
</ul>

<style>
	.work {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.work li + li {
		border-top: 1px solid var(--rule);
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
		gap: 1rem 2.5rem;
		padding: 1.6rem 0;
		color: inherit;
		text-decoration: none;
	}

	.work li:first-child .work-item {
		padding-top: 0;
	}

	.work-type {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--muted);
		font-size: 0.8rem;
	}

	.work-title {
		display: block;
		margin-bottom: 0.5rem;
		color: var(--ink);
		font-size: 1.2rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	a.work-item:hover .work-title {
		color: var(--link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.work-summary {
		display: block;
		max-width: 38rem;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.work-result {
		display: block;
		color: var(--ink);
		font-size: 0.9rem;
		line-height: 1.45;
	}

	.work-status {
		display: block;
		margin-top: 0.5rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-style: italic;
	}

	@media (max-width: 600px) {
		.work-item {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
