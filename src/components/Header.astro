---
// Site header. Desktop shows the links inline; below 720px only the logo stays here and
// MobileNav takes over. Add, remove or reorder pages in NAV_LINKS (src/consts.ts).
import MobileNav from './MobileNav.astro';
import { NAV_LINKS as links } from '../consts';
import { isActive } from '../utils/nav';
---

<header class="site-header">
	<nav class="nav" aria-label="Main">
		<a href="/" class="brand" aria-label="ACmkt home">
			<svg class="brand-mark" width="24" height="14" viewBox="0 0 24 14" aria-hidden="true">
				<circle cx="6" cy="7" r="6" />
				<rect x="10" y="6" width="6" height="2" />
				<circle cx="19" cy="7" r="4" />
			</svg>
			<span class="brand-name">ACmkt</span>
		</a>

		<ul class="links">
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={isActive(Astro.url.pathname, link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<MobileNav />

<style>
	.site-header {
		padding: 1.5rem var(--gutter);
	}

	.nav {
		max-width: var(--content);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: clamp(2.5rem, 6vw, 5rem);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.75rem;
		color: var(--ink);
		text-decoration: none;
	}

	.brand-mark {
		fill: currentColor;
	}

	.brand-name {
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.links {
		display: flex;
		gap: 1.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: inline-block;
		padding: 0.25rem 0;
		color: var(--ink);
		font-size: 0.9rem;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.15s ease;
	}

	.links a:hover,
	.links a[aria-current='page'] {
		border-bottom-color: currentColor;
	}

	.brand:focus-visible,
	.links a:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 4px;
		border-radius: 2px;
	}

	/* Mobile: the floating menu in MobileNav.astro replaces these links */
	@media (max-width: 720px) {
		.links {
			display: none;
		}
	}
</style>
