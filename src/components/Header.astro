---
// Main navigation. Add, remove or reorder pages here.
const links = [
	{ href: '/about', label: 'About' },
	{ href: '/case-studies', label: 'Case Studies' },
	{ href: '/skills', label: 'Skills' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contact', label: 'Contact' },
];

// Marks the current page in the menu (also works for /blog/post-name)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
	<nav class="nav" aria-label="Main">
		<a href="/" class="brand" aria-label="ACmkt home">
			<svg class="brand-mark" width="24" height="14" viewBox="0 0 24 14" aria-hidden="true">
				<circle cx="6" cy="7" r="6" />
				<rect x="10" y="6" width="6" height="2" />
				<circle cx="19" cy="7" r="4" />
			</svg>
			<span class="brand-name">ACmkt</span>
		</a>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
			Menu
		</button>

		<ul class="links" id="nav-links">
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const toggle = document.querySelector('.menu-toggle');
	const links = document.getElementById('nav-links');

	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		links?.classList.toggle('is-open', !open);
	});
</script>

<style>
	.site-header {
		padding: 1.5rem clamp(1.25rem, 4vw, 3rem);
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: clamp(2.5rem, 6vw, 5rem);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: #1f1f1f;
		text-decoration: none;
	}

	.brand-mark {
		fill: currentColor;
	}

	.brand-name {
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.links {
		display: flex;
		gap: 1.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: inline-block;
		padding: 0.25rem 0;
		color: #1f1f1f;
		font-size: 0.9rem;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 0.15s ease;
	}

	.links a:hover,
	.links a[aria-current='page'] {
		border-bottom-color: currentColor;
	}

	.brand:focus-visible,
	.links a:focus-visible,
	.menu-toggle:focus-visible {
		outline: 2px solid #1f1f1f;
		outline-offset: 4px;
		border-radius: 2px;
	}

	.menu-toggle {
		display: none;
	}

	/* Mobile: links collapse behind a "Menu" button */
	@media (max-width: 720px) {
		.menu-toggle {
			display: inline-block;
			margin-left: auto;
			padding: 0.4rem 0.9rem;
			background: none;
			border: 1px solid #1f1f1f;
			border-radius: 999px;
			color: #1f1f1f;
			font: inherit;
			font-size: 0.85rem;
			cursor: pointer;
		}

		.links {
			display: none;
			width: 100%;
			flex-direction: column;
			gap: 0.25rem;
			padding-top: 1.25rem;
		}

		.links.is-open {
			display: flex;
		}

		.links a {
			padding: 0.6rem 0;
			font-size: 1.05rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.links a {
			transition: none;
		}
	}
</style>