---
// Everything inside <head>: metadata, social cards, fonts and site-wide schema
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string; // a file in /public, e.g. '/og-default.png'
	imageAlt?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const {
	title,
	description,
	image = '/og-default.png',
	imageAlt = 'Ana Carolina Gomes, SEO and Digital PR Specialist',
	type = 'website',
	noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://ac-mkt.github.io');
const siteUrl = site.href.replace(/\/$/, '');

// Canonical always ends with "/" to match how GitHub Pages serves pages
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(path, site);
const imageURL = new URL(image, site);

// Google Search Console: paste only the code from content="..." between the quotes
const googleVerification = '';

// Site-wide schema graph: who you are, what the site is, and what this page is
const siteGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}/#website`,
			url: `${siteUrl}/`,
			name: SITE_TITLE,
			alternateName: 'Ana Carolina Gomes',
			description: SITE_DESCRIPTION,
			inLanguage: 'en',
			publisher: { '@id': `${siteUrl}/#person` },
		},
		{
			'@type': 'Person',
			'@id': `${siteUrl}/#person`,
			name: 'Ana Carolina Gomes',
			jobTitle: 'SEO & Digital PR Specialist',
			url: `${siteUrl}/`,
			sameAs: ['https://www.linkedin.com/in/anacpsg'],
			address: { '@type': 'PostalAddress', addressLocality: 'Belo Horizonte', addressRegion: 'Minas Gerais', addressCountry: 'BR' },
			alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade Estácio de Sá' },
			knowsLanguage: ['pt', 'en', 'es'],
			knowsAbout: [
				'Search Engine Optimization',
				'Link Building',
				'Digital PR',
				'Generative Engine Optimization',
				'Answer Engine Optimization',
				'Schema Markup',
				'Python',
			],
		},
		{
			'@type': 'WebPage',
			'@id': `${canonicalURL.href}#webpage`,
			url: canonicalURL.href,
			name: title,
			description,
			inLanguage: 'en',
			isPartOf: { '@id': `${siteUrl}/#website` },
			primaryImageOfPage: imageURL.href,
		},
	],
};
---

<!-- Basics -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content="Ana Carolina Gomes" />
<meta name="theme-color" content="#f2f2f0" />
<meta name="generator" content={Astro.generator} />
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}

<!-- Icons, sitemap and feed -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', site)} />

<!-- Self-hosted font, preloaded -->
<Font cssVariable="--font-schibsted" preload />

<!-- Open Graph (LinkedIn, WhatsApp, Slack...) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
