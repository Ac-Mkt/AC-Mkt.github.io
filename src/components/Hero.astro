---
// Homepage hero: eyebrow, H1, subheadline, CTAs and a proof strip.
// Pass an image (e.g. a portrait) through the "media" slot to show it beside the text.
interface Props {
	eyebrow: string;
	title: string;
	subtitle: string;
	stats: { value: string; label: string }[];
	actions: { label: string; href: string; primary?: boolean; download?: boolean }[];
}

const { eyebrow, title, subtitle, stats, actions } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class:list={['hero', { 'has-media': hasMedia }]} aria-labelledby="hero-title">
	<div class="hero-text">
		<p class="eyebrow">{eyebrow}</p>
		<h1 id="hero-title">{title}</h1>
		<p class="subtitle">{subtitle}</p>

		<div class="actions">
			{
				actions.map((action) => (
					<a
						class:list={['btn', { 'btn-primary': action.primary }]}
						href={action.href}
						download={action.download || undefined}
					>
						{action.label}
					</a>
				))
			}
		</div>

		<ul class="proof">
			{
				stats.map((stat) => (
					<li>
						<span class="proof-value">{stat.value}</span>
						<span class="proof-label">{stat.label}</span>
					</li>
				))
			}
		</ul>
	</div>

	{
		hasMedia && (
			<div class="hero-media">
				<slot name="media" />
			</div>
		)
	}
</section>

<style>
	.hero {
		display: grid;
		gap: clamp(2rem, 5vw, 5rem);
		align-items: end;
	}

	.hero.has-media {
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
	}

	.eyebrow {
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-size: 0.85rem;
		letter-spacing: 0.01em;
		line-height: 1.5;
	}

	h1 {
		max-width: 16ch;
		margin: 0 0 1.5rem;
		font-size: clamp(2.25rem, 5.2vw, 4.25rem);
		letter-spacing: -0.04em;
		line-height: 1;
		overflow-wrap: break-word;
	}

	.subtitle {
		max-width: 36rem;
		margin: 0 0 2.25rem;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.55;
	}

	.proof {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem clamp(1.75rem, 4vw, 3rem);
		margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
		padding: 1.5rem 0 0;
		border-top: 1px solid var(--rule);
		list-style: none;
	}

	.proof-value {
		display: block;
		color: var(--ink);
		font-size: clamp(2rem, 3.4vw, 2.75rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.proof-label {
		display: block;
		max-width: 16ch;
		margin-top: 0.5rem;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.4;
	}

	@media (max-width: 860px) {
		.hero.has-media {
			grid-template-columns: 1fr;
		}
	}
</style>
