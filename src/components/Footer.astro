---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner">
		<p>&copy; {year} Ana Carolina Gomes</p>
		<a href="https://www.linkedin.com/in/anacpsg" rel="me">LinkedIn</a>
	</div>
</footer>

<style>
	.site-footer {
		padding: 2rem clamp(1.25rem, 4vw, 3rem) 2.5rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1200px;
		margin: 0 auto;
		padding-top: 1.5rem;
		border-top: 1px solid #d4d4d0;
		color: #5e5e5e;
		font-size: 0.85rem;
	}

	p {
		margin: 0;
	}

	a {
		color: #5e5e5e;
		text-decoration: none;
	}

	a:hover {
		color: #1f3fbf;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	a:focus-visible {
		outline: 2px solid #1f3fbf;
		outline-offset: 3px;
	}
</style>