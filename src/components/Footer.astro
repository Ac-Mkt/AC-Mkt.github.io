---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner">
		<p>&copy; {year} Ana Carolina Gomes</p>
		<a href="https://www.linkedin.com/in/anacpsg" rel="me">LinkedIn</a>
	</div>
</footer>

<style>
	.site-footer {
		padding: 2rem var(--gutter) 2.5rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--content);
		margin: 0 auto;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.85rem;
	}

	p {
		margin: 0;
	}

	/* Padding gives a ~44px tap area; negative margin keeps the footer height */
	a {
		display: inline-block;
		margin: -0.75rem 0;
		padding: 0.75rem 0;
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		color: var(--link);
		text-decoration: underline;
	}

	/* Mobile: leave room for the floating menu button (60px + 28px offset + home bar) */
	@media (max-width: 720px) {
		.site-footer {
			padding-bottom: calc(124px + env(safe-area-inset-bottom));
		}
	}
</style>