---
import { NAV_LINKS } from '../consts';
import { AUTHOR } from '../data/author';

interface Props {
	// Phones: links first, then ©, no LinkedIn (homepage, About, Skills, Blog)
	compact?: boolean;
	// Phones, compact only: space above the footer in px (default 40)
	mobileGap?: number;
}

const { compact = false, mobileGap = 40 } = Astro.props;
const year = new Date().getFullYear();
const links = NAV_LINKS.filter((link) => link.href !== '/contact/');
---

<footer class:list={['site-footer', 'container', { compact }]} style={`--footer-gap: ${mobileGap}px`}>
	<div class="inner">
		<p>&copy; {year} {AUTHOR.name}</p>
		<nav aria-label="Footer">
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
				<li class="linkedin">
					<a href={AUTHOR.linkedinUrl} rel="me">LinkedIn</a>
				</li>
			</ul>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 64px;
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 96px;
		border-top: 1px solid var(--line);
		color: var(--meta);
		font-size: 14px;
		line-height: 1.5;
	}

	p {
		margin: 0;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		color: var(--ink);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* Mobile: stacked; bigger tap areas; room at the bottom for the floating menu button */
	@media (max-width: 767px) {
		.inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
			padding: 32px 0 calc(124px + env(safe-area-inset-bottom));
		}

		ul {
			gap: 0 24px;
		}

		a {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}

		/* Compact variant (homepage, About) */
		.compact {
			margin-top: var(--footer-gap);
		}

		.compact .inner {
			gap: 12px;
			min-height: 0;
			padding: 16px 0 calc(88px + env(safe-area-inset-bottom));
		}

		.compact nav {
			order: -1;
		}

		.compact ul {
			gap: 0 20px;
		}

		.compact .linkedin {
			display: none;
		}
	}
</style>
